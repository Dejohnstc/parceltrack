generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  CREATED
  PICKED_UP
  ORIGIN_FACILITY
  IN_TRANSIT
  ARRIVED_HUB
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  FAILED
  RETURNED
}

enum ShipmentPaymentStatus {
  UNPAID
  PENDING
  PAID
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CRYPTO
}

model User {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId

  name                 String
  email                String   @unique
  password             String
  image                String?

  role                 Role     @default(CUSTOMER)

  emailVerified        Boolean  @default(false)

  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  shipments            Shipment[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Shipment {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId

  customerId         String?  @db.ObjectId
  customer           User?    @relation(fields: [customerId], references: [id])

  trackingNumber     String   @unique

  // Reference
 referenceNumber String?

  // Sender
  senderName         String
  senderEmail        String
  senderPhone        String?
  senderAddress      String?

  // Receiver
  receiverName       String
  receiverEmail      String
  receiverPhone      String?
  receiverAddress    String?

  // Route
  origin             String
  destination        String
  currentLocation    String

  // Package
  service            String?
  packageType        String?
  packageDescription String?
  weight             Float?
  pieces             Int?

  // Delivery
  expectedDelivery   DateTime?
  estimatedTransitDays Int?

  // Shipment status
  status             ShipmentStatus

  // Shipment financial information
  declaredValue      Float?
  currency           String?  @default("USD")
  shippingCost       Float?
  insurance          Float?

  // Payment
  payment            ShipmentPayment?

  // Tracking
  trackingEvents     TrackingEvent[]

  // Dates
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ShipmentPayment {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId

  shipmentId        String                @unique @db.ObjectId
  shipment          Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Amount customer needs to pay
  amount            Float
  currency          String                @default("USD")

  // Payment state
  status            ShipmentPaymentStatus @default(UNPAID)

  // Payment method selected by customer
  paymentMethod     PaymentMethod?

  // Crypto payment information
  cryptoCurrency    String?
  cryptoNetwork     String?
  paymentAddress    String?

  // Customer payment reference
  transactionRef    String?

  // Admin approval information
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?

  approvedBy        String?               @db.ObjectId

  // Dates
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model TrackingEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  shipmentId    String   @db.ObjectId

  shipment      Shipment @relation(fields: [shipmentId], references: [id])

  status        ShipmentStatus

  location      String

  description   String

  createdAt     DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  userId      String?  @db.ObjectId
  shipmentId  String?  @db.ObjectId

  action      String
  description String

  createdAt   DateTime @default(now())
}

model CompanySettings {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  companyName   String
  supportEmail  String
  supportPhone  String

  logo          String?

  primaryColor  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}